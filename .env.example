# ============================================
# Talati Onboarding Backend — Environment Vars
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Upstash Redis (get these from https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Authentication
# Generate a strong random string (min 32 chars): openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-string-minimum-32-chars

# JWT token lifetime in seconds (default: 1800 = 30 minutes)
JWT_EXPIRES_IN=1800

# CORS — your frontend domain (no trailing slash)
CORS_ORIGIN=https://your-frontend.vercel.app

# Environment
NODE_ENV=production
